flowchart TD
    %% Subgraph: UI / View Layer
    subgraph UI_Layer ["**UI / View Layer (JavaFX)**"]
        APP[App.java]
        FXML_SELECT[selectTournament-view.fxml]
        FXML_CREATE[createTournament-view.fxml]
        FXML_START[startTournament-view.fxml]
        FXML_ROUND[roundTournament-view.fxml]
        
        CTRL_SELECT[selectTournamentController]
        CTRL_CREATE[createTournamentController]
        CTRL_START[startTournamentController]
        CTRL_ROUND[roundTournamentController]
        
        NAV[FxmlNavigation.java]
    end

    %% Subgraph: Service & Logic Layer
    subgraph Service_Layer ["**Service & Business Logic Layer**"]
        MGR[ServiceManager.java]
        SVC_T[TournamentService]
        SVC_P[PlayerService]
        SVC_TM[TeamService]
        SVC_M[MatchService]
        
        CORE_TM[TeamMaker.java]
        CORE_MM[MatchMaker.java]
        SVC_MKR[MakerService.java]
    end

    %% Subgraph: Data Access Layer
    subgraph Data_Layer ["**Data Access Layer (DAO & Repo)**"]
        REPO_T[TournamentRepository]
        REPO_P[PlayerRepository]
        REPO_TM[TeamRepository]
        REPO_M[MatchRepository]
        
        DAO_T[SQLiteTournamentDao]
        DAO_P[SQLitePlayerDao]
        DAO_TM[SQLiteTeamDao]
        DAO_M[SQLiteMatchDao]
        
        DB_CONN[SQLiteDB.java]
        SQL_R[SQLReader.java]
    end

    %% Subgraph: Domain Models
    subgraph Domain_Layer ["**Domain Models (Records/Classes)**"]
        MODEL_T[(Tournament)]
        MODEL_P[(Player)]
        MODEL_TM[(Team)]
        MODEL_M[(Match)]
    end

    %% Relationships: UI to Service
    APP -->|Initial Load| NAV
    NAV --> FXML_SELECT
    FXML_SELECT --> CTRL_SELECT
    
    CTRL_SELECT -->|getServices| MGR
    CTRL_CREATE -->|getServices| MGR
    CTRL_START -->|getServices| MGR
    CTRL_ROUND -->|getServices| MGR
    
    MGR --> SVC_T
    MGR --> SVC_P
    MGR --> SVC_TM
    MGR --> SVC_M
    MGR --> SVC_MKR

    %% Relationships: Service to Data/Core
    SVC_T --> REPO_T
    SVC_P --> REPO_P
    SVC_TM --> REPO_TM
    SVC_M --> REPO_M
    
    SVC_MKR --> CORE_TM
    SVC_MKR --> CORE_MM
    
    CORE_TM --> DAO_TM
    CORE_MM --> DAO_M
    
    %% Relationships: Repo to DAO
    REPO_T --> DAO_T
    REPO_P --> DAO_P
    REPO_TM --> DAO_TM
    REPO_M --> DAO_M
    
    %% Relationships: DAO to Database
    DAO_T --> DB_CONN
    DAO_P --> DB_CONN
    DAO_TM --> DB_CONN
    DAO_M --> DB_CONN
    
    DB_CONN -->|init| SQL_R
    DB_CONN -->|SQL Execution| SQLITE[(sqlite file)]

    %% Data Flow Examples
    CTRL_CREATE -.->|create Tournament| SVC_T
    SVC_T -.->|save| REPO_T
    REPO_T -.->|INSERT| DAO_T
    DAO_T -.->|return| MODEL_T

    %% Styling
    style APP fill:#f9f,stroke:#333,stroke-width:2px
    style SQLITE fill:#00f,stroke:#fff,stroke-width:2px,color:#fff
    style MODEL_T fill:#fff,stroke:#333,stroke-dasharray: 5 5
    style MODEL_P fill:#fff,stroke:#333,stroke-dasharray: 5 5
    style MODEL_TM fill:#fff,stroke:#333,stroke-dasharray: 5 5
    style MODEL_M fill:#fff,stroke:#333,stroke-dasharray: 5 5
