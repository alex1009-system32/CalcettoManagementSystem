graph TD
    subgraph "UI Layer (JavaFX)"
        direction LR
        subgraph "Navigation"
            APP["App.java (start)"] --> NAV_FXML["FxmlNavigation.java"]
        end
        subgraph "Views (FXML)"
            direction TB
            FXML_SELECT["selectTournament-view.fxml"]
            FXML_CREATE["createTournament-view.fxml"]
            FXML_START["startTournament-view.fxml"]
            FXML_ROUND["roundTournament-view.fxml"]
        end
        subgraph "Controllers"
            direction TB
            CTRL_SELECT["selectTournamentController"]
            CTRL_CREATE["createTournamentController"]
            CTRL_START["startTournamentController"]
            CTRL_ROUND["roundTournamentController"]
        end
    end

    subgraph "Service Layer"
        direction TB
        MGR["ServiceManager.java"]
        subgraph "Services"
            SVC_T["TournamentService"]
            SVC_P["PlayerService"]
            SVC_TM["TeamService"]
            SVC_M["MatchService"]
            SVC_MKR["MakerService"]
        end
    end

    subgraph "Core Logic"
        direction TB
        CORE_TM["TeamMaker.java"]
        CORE_MM["MatchMaker.java"]
        CORE_SHUFFLER["TeamShuffler.java"]
        CORE_WINNER["WinnerExtractor.java"]
    end

    subgraph "Data Layer"
        direction TB
        subgraph "Repositories"
            REPO_T["TournamentRepository"]
            REPO_P["PlayerRepository"]
            REPO_TM["TeamRepository"]
            REPO_M["MatchRepository"]
            REPO_MKR["MakerRepository"]
        end
        subgraph "DAO (SQLite Implementation)"
            DAO_T["SQLiteTournamentDao"]
            DAO_P["SQLitePlayerDao"]
            DAO_TM["SQLiteTeamDao"]
            DAO_M["SQLiteMatchDao"]
        end
        subgraph "Database"
            DB_CONN["SQLiteDB.java"] --> SQL_R["SQLReader.java"]
            DB_CONN --> SQLITE[("calcettomanagmentsystem.db")]
        end
    end

    subgraph "Domain Models"
        direction TB
        MODEL_T[("Tournament")]
        MODEL_P[("Player")]
        MODEL_TM[("Team")]
        MODEL_M[("Match")]
    end

    %% --- Relationships ---

    %% UI Flow
    NAV_FXML --> FXML_SELECT & FXML_CREATE & FXML_START & FXML_ROUND
    FXML_SELECT --> CTRL_SELECT
    FXML_CREATE --> CTRL_CREATE
    FXML_START --> CTRL_START
    FXML_ROUND --> CTRL_ROUND

    %% Controller to Service
    CTRL_SELECT & CTRL_CREATE & CTRL_START & CTRL_ROUND --> MGR
    MGR --> SVC_T & SVC_P & SVC_TM & SVC_M & SVC_MKR

    %% Service to Repos/Logic
    SVC_T --> REPO_T
    SVC_P --> REPO_P
    SVC_TM --> REPO_TM
    SVC_M --> REPO_M
    SVC_MKR --> REPO_MKR
    
    SVC_MKR --> CORE_TM & CORE_MM
    CORE_MM --> CORE_SHUFFLER & CORE_WINNER

    %% Data Mapping
    REPO_T --> DAO_T
    REPO_P --> DAO_P
    REPO_TM --> DAO_TM
    REPO_M --> DAO_M
    REPO_MKR --> DAO_TM & DAO_M & DAO_P
    
    DAO_T & DAO_P & DAO_TM & DAO_M --> DB_CONN

    %% Model Usage (Dashed lines for mapping)
    DAO_T -.-> MODEL_T
    DAO_P -.-> MODEL_P
    DAO_TM -.-> MODEL_TM
    DAO_M -.-> MODEL_M

    %% Styling
    classDef ui fill:#f9f,stroke:#333,stroke-width:2px
    classDef service fill:#bbf,stroke:#333,stroke-width:2px
    classDef core fill:#fb9,stroke:#333,stroke-width:2px
    classDef data fill:#9f9,stroke:#333,stroke-width:2px
    classDef db fill:#0af,color:#fff,stroke:#036,stroke-width:2px
    classDef model fill:#fff,stroke:#333,stroke-dasharray: 5 5

    class APP,NAV_FXML,FXML_SELECT,FXML_CREATE,FXML_START,FXML_ROUND,CTRL_SELECT,CTRL_CREATE,CTRL_START,CTRL_ROUND ui
    class MGR,SVC_T,SVC_P,SVC_TM,SVC_M,SVC_MKR service
    class CORE_TM,CORE_MM,CORE_SHUFFLER,CORE_WINNER core
    class REPO_T,REPO_P,REPO_TM,REPO_M,REPO_MKR,DAO_T,DAO_P,DAO_TM,DAO_M,DB_CONN,SQL_R data
    class SQLITE db
    class MODEL_T,MODEL_P,MODEL_TM,MODEL_M model