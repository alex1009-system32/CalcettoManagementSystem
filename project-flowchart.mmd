flowchart TD
  A[App.start] --> B[Load SELECT_TOURNAMENT.fxml]
  B --> STC[selectTournamentController]
  STC -->|load list| DAO_T_GET[SQLiteTournamentDao.getAllTournaments]
  STC -->|Add Tournament| CTC[createTournamentController]
  STC -->|Select Tournament| ROUTE{current_round}
  ROUTE -->|<= 0| SVC[startTournamentController]
  ROUTE -->|> 0| RTC[roundTournamentController]

  CTC --> VAL{valid input?}
  VAL -->|Yes| DAO_T_ADD[SQLiteTournamentDao.addTournament]
  VAL -->|No| CTC
  DAO_T_ADD --> STC

  SVC -->|init| DAO_P_GET[SQLitePlayerDao.getAllPlayersFromTournament]
  SVC -->|Add Player| DAO_P_ADD[SQLitePlayerDao.addPlayer]
  SVC -->|Delete Player| DAO_P_DEL[SQLitePlayerDao.deletePlayer]
  SVC -->|Start Tournament| SRV_MKR[MakerRepository]

  subgraph Service_&_Core
    SRV_MKR
    CORE_TM[TeamMaker.makeTeams]
    CORE_MM[MatchMaker.makePreRounds]
  end

  SRV_MKR --> CORE_TM
  SRV_MKR --> CORE_MM

  CORE_TM --> DAO_TEAM[SQLiteTeamDao]
  CORE_TM --> DAO_PLY[SQLitePlayerDao]
  CORE_MM --> DAO_MATCH[SQLiteMatchDao]
  CORE_MM --> DAO_T_INC[SQLiteTournamentDao.increaseRound]
  CORE_MM --> DAO_TEAM

  RTC -->|show round| DAO_MATCH_R[SQLiteMatchDao.getAllMatches...]

  subgraph Data_Access
    DAO_T_GET
    DAO_T_ADD
    DAO_T_INC
    DAO_P_GET
    DAO_P_ADD
    DAO_P_DEL
    DAO_TEAM
    DAO_MATCH
    DAO_MATCH_R
    DB[(SQLiteDB.getConnection)]
    DAO_T_GET --> DB
    DAO_T_ADD --> DB
    DAO_T_INC --> DB
    DAO_P_GET --> DB
    DAO_P_ADD --> DB
    DAO_P_DEL --> DB
    DAO_TEAM --> DB
    DAO_MATCH --> DB
    DAO_MATCH_R --> DB
  end

  subgraph Domain
    Tournament
    Team
    Player
    Match
  end

  DAO_T_ADD -. creates .-> Tournament
  DAO_P_ADD -. inserts .-> Player
  DAO_MATCH -. creates .-> Match
