flowchart TD
  A[App.start] --> B[Load SELECTTOURNAMENT FXML]
  B --> C{User Action}
  C -->|Select Tournament| D[App.setTournament → STARTTOURNAMET]
  C -->|Add Tournament| E[CREATETOURNAMENT]
  E --> E1[createTournamentController.validate]
  E1 -->|Valid| E2[SQLiteTournamentDao.addTournament]
  E2 --> B
  E1 -->|Invalid| E
  D --> D1[startTournametController.initialize]
  D1 -->|current_round != -1| F[ROUNDTOURNAMET]
  D1 -->|current_round == -1| G[Show Tournament & Players]
  G --> G1[+ Add Player Modal]
  G1 --> G2[SQLitePlayerDao.addPlayer]
  G --> H[go Back → SELECTTOURNAMENT]
  F --> F1[roundTournametController]

  subgraph UI_Navigation[UI Navigation]
    B
    E
    D
    F
  end

  subgraph Data_Access[Data Access]
    T[SQLiteTournamentDao]
    P[SQLitePlayerDao]
    Te[SQLiteTeamDao]
    M[SQLiteMatchDao]
    DB[[SQLiteDB.getConnection → sqlite file]]
    T --> DB
    P --> DB
    Te --> DB
    M --> DB
    M --> Te
    P --> T
  end

  subgraph Domain[Domain Model]
    To[(Tournament)]
    TeM[(Team)]
    Pl[(Player)]
    Ma[(Match)]
    To --- Pl
    To --- TeM
    Ma --- TeM
  end

  E2 -. creates .-> To
  G2 -. inserts .-> Pl
  D1 -. reads .-> Pl
  F1 -. reads .-> Ma
