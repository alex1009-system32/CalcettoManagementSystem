<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<fx:root alignment="CENTER" type="HBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="org.example.calcettomanagmentsystem.ui.controller.components.WinnerPaneController">

    <stylesheets>
        <URL value="@../../css/global-styles.css"/>
        <URL value="@../../css/components/winner-pane-styles.css"/>
    </stylesheets>

    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
              prefHeight="700.0" prefWidth="500.0">
            <children>
                <VBox prefHeight="95.0" prefWidth="600.0" styleClass="header-area" VBox.vgrow="ALWAYS">
                    <children>
                        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                               styleClass="header-title" text="Winner"/>
                        <Region prefHeight="200.0" prefWidth="200.0" styleClass="accent-line"/>
                    </children>
                </VBox>
                <Label fx:id="winnerLabel" alignment="TOP_CENTER" maxHeight="1.7976931348623157E308"
                       maxWidth="1.7976931348623157E308" prefHeight="254.0" prefWidth="600.0"
                       styleClass="subheader-title" text="Label" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="30.0"/>
                    </padding>
                </Label>
            </children>
        </VBox>
    </children>
</fx:root>
