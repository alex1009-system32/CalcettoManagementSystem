<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root type="Button"
        onAction="#openModal"
        styleClass="tournament-list-button, match-button"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.calcettomanagmentsystem.controller.components.MatchCartController">
    <graphic>
        <HBox styleClass="match-content-hbox">
            <children>
                <Label fx:id="matchInfoLabel"
                       styleClass="label-major, match-info-label"
                       text="Match Name Placeholder" />
            </children>
        </HBox>
    </graphic>
</fx:root>