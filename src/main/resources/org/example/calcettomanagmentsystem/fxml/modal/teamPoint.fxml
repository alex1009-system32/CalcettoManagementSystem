<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="HBox"
      styleClass="match-update-row"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.calcettomanagmentsystem.controller.modal.MatchPointController">

    <stylesheets>
        <URL value="@../../css/global-styles.css" />
        <URL value="@../../css/modal/matchPoint.css" />
    </stylesheets>

    <Label fx:id="teamNameLabel"
           styleClass="label-major"
           HBox.hgrow="ALWAYS"
           maxWidth="Infinity" />

    <TextField fx:id="pointTextField"
               styleClass="text-field-custom, match-update-field"
               promptText="pts" />

    <Button fx:id="saveBtn"
            text="Save"
            styleClass="btn-save"
            onAction="#savePoint" />
</fx:root>