<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="800.0" prefWidth="1200.0" styleClass="main-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.calcettomanagmentsystem.controller.view.StartTournamentController">
    <stylesheets>
        <URL value="@../../css/global-styles.css" />
        <URL value="@../../css/view/startTournament-styles.css" />
    </stylesheets>

    <children>
        <VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="400.0">
            <children>
                <VBox spacing="30.0" styleClass="card">
                    <children>
                        <VBox alignment="CENTER" spacing="10.0">
                            <Label fx:id="tournamentNameLabel" styleClass="header-title" text="Emerald Cup" />
                            <Region styleClass="accent-line" />
                        </VBox>

                        <VBox spacing="20.0" styleClass="stats-container">
                            <children>
                                <VBox styleClass="stat-item">
                                    <Label styleClass="input-label" text="PRE ROUND" />
                                    <Label fx:id="preRoundLabel" styleClass="label-major" text="Group Stage" />
                                </VBox>
                                <VBox styleClass="stat-item">
                                    <Label styleClass="input-label" text="CURRENT ROUND" />
                                    <Label fx:id="currentRoundLabel" styleClass="label-major-primary" text="Semi-Finals" />
                                </VBox>
                                <VBox styleClass="stat-item">
                                    <Label styleClass="input-label" text="MAX TEAM SIZE" />
                                    <Label fx:id="maxTeamSizeLabel" styleClass="label-major" text="5 vs 5" />
                                </VBox>
                            </children>
                        </VBox>

                        <VBox spacing="15.0">
                            <Button maxWidth="1.7976931348623157E308" onAction="#openModal" styleClass="btn-base, btn-primary" text="+ Add Player" />
                            <Button maxWidth="1.7976931348623157E308" onAction="#goBack" styleClass="btn-base, btn-outline" text="Go Back" />
                        </VBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets left="40.0" right="20.0" />
            </padding>
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <children>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="400.0" styleClass="custom-scroll-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="playerFlowPane" alignment="TOP_CENTER" hgap="15" styleClass="player-grid" vgap="15" />
                    </content>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </ScrollPane>
                <VBox alignment="CENTER" prefHeight="120.0" styleClass="footer-area">
                    <children>
                        <Button onAction="#startTournament" prefHeight="55.0" prefWidth="400.0" styleClass="btn-base, btn-primary" text="Start Tournament" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
