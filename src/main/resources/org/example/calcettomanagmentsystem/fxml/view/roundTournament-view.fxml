<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="1200.0" styleClass="main-container" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.calcettomanagmentsystem.controller.view.RoundTournamentController">
    <stylesheets>
        <URL value="@../../css/global-styles.css"/>
        <URL value="@../../css/view/roundTournament-styles.css"/>
    </stylesheets>
    <children>
        <TabPane fx:id="matchOfRoundPane" styleClass="custom-tab-pane" tabClosingPolicy="UNAVAILABLE"
                 VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER" prefHeight="120.0" spacing="30.0">
            <children>
                <Button mnemonicParsing="false" onAction="#goBack" prefWidth="200.0" text="Return">
                    <styleClass>
                        <String fx:value="btn-base"/>
                        <String fx:value="btn-outline"/>
                    </styleClass>
                </Button>
                <Button mnemonicParsing="false" onAction="#nextRound" prefWidth="200.0" text="Next Round">
                    <styleClass>
                        <String fx:value="btn-base"/>
                        <String fx:value="btn-primary"/>
                    </styleClass>
                </Button>
            </children>
            <padding>
                <Insets bottom="20.0" top="20.0"/>
            </padding>
        </HBox>
    </children>
</VBox>
